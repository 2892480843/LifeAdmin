# Frontend AMap JS API key. This is browser-visible by design.
VITE_AMAP_KEY=1135c2b85b85335f075a0fc4085f1943
VITE_AMAP_SECURITY_CODE=adad12b93dff610aadb792a185575b38

# Local Agent service.
AGENT_PORT=8787
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174
AGENT_AUTH_MODE=demo
AGENT_PRODUCTION_AUTH_READY=0
AGENT_API_TOKEN=change-me-local-agent-token
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX=30
AGENT_AMAP_CACHE_TTL_MS=600000
AGENT_AMAP_MIN_INTERVAL_MS=250

# LLM provider.
# Supported values: deepseek, longcat.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=REDACTED
DEEPSEEK_BASE_URL=https://api.deepseek.com
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1

# AMap Web Service key for server-side POI search.
AMAP_WEB_SERVICE_KEY=

# Meituan LBS Web Service key for map APIs such as map matching, geocoding and routing.
MEITUAN_LBS_WEB_SERVICE_KEY=

# Dianping POI Open API, server-side only.
DIANPING_APP_KEY=
DIANPING_APP_SECRET=
DIANPING_SESSION=
DIANPING_CACHE_TTL_MS=600000
DIANPING_MIN_INTERVAL_MS=300

# Frontend Agent endpoint. VITE_* values are browser-visible.
# VITE_AGENT_API_TOKEN is demo-only and must stay empty in production.
VITE_AGENT_API_BASE_URL=http://localhost:8787
VITE_AGENT_AUTH_MODE=demo
VITE_AGENT_API_TOKEN=change-me-local-agent-token
